# Solo para `supabase functions serve` en local (copiar a supabase/functions/.env).
# En producción se configuran con `supabase secrets set ...`.
RESEND_API_KEY=re_xxx
MAIL_FROM="Cambios de Turno <turnos@tu-dominio.cl>"
ALLOWED_ORIGIN=http://localhost:5173
# resend (por defecto) | smtp | simulado (solo local: no envía nada y responde OK)
MAIL_PROVIDER=resend
# Con MAIL_PROVIDER=smtp (p. ej. Gmail con contraseña de aplicación; puerto 465):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion
