# Copia este archivo a .env.local y completa con los datos de TU proyecto Supabase
# (Dashboard → Project Settings → API). Solo van valores públicos:
# la URL y la anon key (o publishable key). La service role key NUNCA va aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
